{
  "name": "skinnycoder",
  "version": "0.2.0",
  "description": "A lean amber-terminal coding CLI that delegates thinking to Codex and keeps local edits explicit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainit-consulting/skinnycoder.git"
  },
  "bin": {
    "skinnycoder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "skinnycoder.html"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "test:review": "npm run build && node scripts/review-collector-test.mjs",
    "test:interaction": "npm run build && node scripts/interaction-test.mjs",
    "test:workflow": "npm run build && node scripts/workflow-test.mjs",
    "test:skills": "npm run build && node scripts/skill-manager-test.mjs",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "diff": "^8.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
